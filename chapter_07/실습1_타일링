{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOmhLOhuCFf4OGMCTMJwx7Z"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"1OGzZ14cBkIt"},"outputs":[],"source":["import numpy as np\n","\n","def tiled_matrix_multiplication(A, B, tile_size):\n","    \"\"\"\n","    타일링(Tiling) 기법을 사용하여 행렬 곱셈을 수행합니다.\n","\n","    Args:\n","        A (np.ndarray): 첫 번째 행렬.\n","        B (np.ndarray): 두 번째 행렬.\n","        tile_size (int): 각 타일(블록)의 크기.\n","\n","    Returns:\n","        np.ndarray: 행렬 곱셈의 결과.\n","    \"\"\"\n","    M, K = A.shape\n","    K_b, N = B.shape\n","\n","    if K != K_b:\n","        raise ValueError(\"입력 행렬의 차원이 곱셈에 적합하지 않습니다.\")\n","\n","    # 결과를 저장할 행렬을 0으로 초기화\n","    C = np.zeros((M, N), dtype=A.dtype)\n","\n","    print(f\"{M}x{K} 행렬과 {K}x{N} 행렬을 {tile_size}x{tile_size} 타일로 곱셈합니다.\")\n","\n","    # M, N, K 차원을 타일 크기에 맞게 반복\n","    for i in range(0, M, tile_size):\n","        for j in range(0, N, tile_size):\n","            for k in range(0, K, tile_size):\n","                # 현재 처리할 타일(블록)을 정의\n","                # A의 행과 K의 열에서 타일 추출\n","                A_tile = A[i:i + tile_size, k:k + tile_size]\n","\n","                # B의 K 행과 N의 열에서 타일 추출\n","                B_tile = B[k:k + tile_size, j:j + tile_size]\n","\n","                # 타일 간의 행렬 곱셈을 수행하고\n","                # 최종 결과 행렬의 해당 위치에 누적\n","                C[i:i + tile_size, j:j + tile_size] += A_tile @ B_tile\n","\n","    return C"]},{"cell_type":"code","source":["# 시뮬레이션을 위한 파라미터 설정\n","MATRIX_SIZE = 1024\n","TILE_SIZE = 256 # SRAM에 들어갈 수 있는 블록 크기라고 가정\n","\n","# 무작위 행렬 생성\n","A = np.random.randn(MATRIX_SIZE, MATRIX_SIZE).astype(np.float64)\n","B = np.random.randn(MATRIX_SIZE, MATRIX_SIZE).astype(np.float64)\n","\n","# 타일링을 이용한 행렬 곱셈 수행\n","C_tiled = tiled_matrix_multiplication(A, B, TILE_SIZE)\n","\n","# NumPy의 내장 함수를 이용한 직접 계산 (검증용)\n","C_direct = A @ B\n","\n","# 두 결과가 매우 가까운지 확인 (부동소수점 오차 고려)\n","is_close = np.allclose(C_tiled, C_direct, rtol=1e-5, atol=1e-8)\n","\n","print(\"\\n타일링 계산 결과와 직접 계산 결과 비교:\")\n","print(f\"결과 일치 여부: {is_close}\")\n","\n","if is_close:\n","    print(\"성공: 타일링을 이용한 행렬 곱셈이 정확하게 수행되었습니다.\")\n","else:\n","    print(\"실패: 계산 결과에 오차가 발생했습니다.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kZL0Ll_lCp3Z","executionInfo":{"status":"ok","timestamp":1757599008743,"user_tz":-540,"elapsed":1023,"user":{"displayName":"suhyun cho","userId":"07281409191347897655"}},"outputId":"373c1f2b-549c-49c9-ce71-52a15d48c777"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["1024x1024 행렬과 1024x1024 행렬을 256x256 타일로 곱셈합니다.\n","\n","타일링 계산 결과와 직접 계산 결과 비교:\n","결과 일치 여부: True\n","성공: 타일링을 이용한 행렬 곱셈이 정확하게 수행되었습니다.\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"-Js6jbFDEINg"},"execution_count":null,"outputs":[]}]}